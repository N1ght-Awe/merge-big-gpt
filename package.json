  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
